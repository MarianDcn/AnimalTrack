# Connection string primit de la Neon (Settings -> Connection Details)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret folosit pentru semnarea token-urilor JWT (foloseste o valoare lunga si aleatoare)
JWT_SECRET="schimba-aceasta-valoare"

# Durata de valabilitate a token-ului JWT
JWT_EXPIRES_IN="7d"

# Portul pe care porneste API-ul NestJS
PORT=3000

# Adresa frontend-ului, folosita pentru configurarea CORS
FRONTEND_URL="http://localhost:5173"
