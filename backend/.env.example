# Connection string primit de la Neon (Settings -> Connection Details)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret folosit pentru semnarea token-urilor JWT (foloseste o valoare lunga si aleatoare)
JWT_SECRET="schimba-aceasta-valoare"

# Durata de valabilitate a token-ului JWT
JWT_EXPIRES_IN="7d"

# Portul pe care porneste API-ul NestJS
PORT=3000

# Adresa frontend-ului, folosita pentru configurarea CORS
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 - folosit pentru backup automat saptamanal (bucket PRIVAT, nu public)
# Dashboard Cloudflare -> R2 -> creeaza bucket "animaltrack-backups" -> Manage API tokens
R2_ACCOUNT_ID="id-ul contului tau Cloudflare"
R2_ACCESS_KEY_ID="access key id-ul tokenului R2"
R2_SECRET_ACCESS_KEY="secret access key-ul tokenului R2"
R2_BACKUP_BUCKET_NAME="animaltrack-backups"
